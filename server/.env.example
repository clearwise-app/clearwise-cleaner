# Copy to .env and fill in. Never commit .env: it holds the license signing key.
# Generate LICENSE_*, AUTH_PEPPER and ADMIN_TOKEN with:  npm run keys   or on the server:  docker compose run --rm api node dist/keys.js

# --- Domain and URLs ---
# Domain of this server; Caddy issues the certificate for it.
API_DOMAIN=api.example.com
PUBLIC_URL=https://api.example.com
# The marketing site, allowed to call the API from the browser (comma-separated).
CORS_ORIGINS=https://example.com,https://clearwise-app.github.io

# --- Database (docker-compose builds DATABASE_URL from this) ---
POSTGRES_PASSWORD=change-me-long-random

# --- License tokens (Ed25519, base64 raw keys). The public key also goes into the app. ---
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_OFFLINE_DAYS=14
LICENSE_GRACE_DAYS=7
MAX_DEVICES=3

# --- Sign-in ---
AUTH_PEPPER=
LOGIN_CODE_TTL_MINUTES=15
# SMTP for sign-in codes: smtps://USER:PASSWORD@smtp.host:465  (Resend, Postmark, Amazon SES, Yandex 360 …)
SMTP_URL=
MAIL_FROM=Clearwise <no-reply@example.com>

# --- Billing ---
# paddle | manual (no payments, subscriptions granted through /admin/grant)
BILLING_PROVIDER=paddle
# sandbox while testing, production when the Paddle account is approved
PADDLE_ENV=sandbox
# Paddle > Developer tools > Authentication: API key (server) and client-side token (browser)
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# Paddle > Developer tools > Notifications: destination https://api.example.com/webhooks/paddle, subscription.* events
PADDLE_WEBHOOK_SECRET=
# Paddle > Catalog > Products > Clearwise Cleaner: price ids (pri_…)
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=

# --- Downloads ---
# Public URL of the latest notarized DMG in object storage (Cloudflare R2, Backblaze B2, S3 …)
DOWNLOAD_URL=
LATEST_VERSION=
# Sparkle appcast.xml location, served at /appcast.xml
APPCAST_URL=

# --- Admin (/admin/grant). Empty disables the admin endpoints. ---
ADMIN_TOKEN=
