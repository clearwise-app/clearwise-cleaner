# Caddy obtains and renews the HTTPS certificate for API_DOMAIN by itself (the DNS A record must point here).
{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy api:3000
}
