    },
    "Пропущено: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped: %@"
          }
        }
      }
    },
    "Прочитано за всё время": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read in total"
          }
        }
      }
    },
    "Прочитать снова": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read again"
          }
        }
      }
    },
    "Прочитать список": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the list"
          }
        }
      }
    },
    "Работает": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      }
    },
    "Работает без интернета и ничего никуда не отправляет.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works offline and never sends anything anywhere."
          }
        }
      }
    },
    "Работает нормально": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working normally"
          }
        }
      }
    },
    "Работают от имени системы для всех пользователей. Изменения — с паролем администратора.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run as the system for all users. Changes require an administrator password."
          }
        }
      }
    },
    "Работающее сейчас остановится и больше не будет запускаться само — ни при входе, ни по расписанию. Файлы остаются на месте: включить обратно можно здесь же, кнопкой «Включить».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything running now will stop and will no longer start on its own, at login or on a schedule. The files stay in place: you can turn it back on right here with \"Turn on\"."
          }
        }
      }
    },
    "Рабочий стол": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop"
          }
        }
      }
    },
    "Разделы": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sections"
          }
        }
      }
    },
    "Размер": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "Размер от": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size from"
          }
        }
      }
    },
    "Разрешите доступ ко всему диску": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to the whole disk"
          }
        }
      }
    },
    "Режим очистки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup mode"
          }
        }
      }
    },
    "Режим только расставляет галочки — перед очисткой всё видно и можно поправить. Корзина, последняя копия каждого iPhone и тома Docker не отмечаются никогда.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mode only sets the checkmarks — everything is visible before cleanup and can be adjusted. The Trash, the latest backup of each iPhone and Docker volumes are never selected."
          }
        }
      }
    },
    "Резерв на исходе": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare running out"
          }
        }
      }
    },
    "Резервные блоки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare blocks"
          }
        }
      }
    },
    "Результаты неполные — нет полного доступа к диску": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results are incomplete — no Full Disk Access"
          }
        }
      }
    },
    "Ресурс выработан": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance used up"
          }
        }
      }
    },
    "Самопроверка (SMART)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-check (SMART)"
          }
        }
      }
    },
    "Самопроверка диска не нашла неполадок.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk's self-check found no problems."
          }
        }
      }
    },
    "Сборка для разработки": {
