    },
    "Готово. Убрано %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Removed %@"
          }
        }
      }
    },
    "Готово: %@. Не получилось: %@ — %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done: %@. Failed: %@ — %@"
          }
        }
      }
    },
    "Давление памяти показывает, хватает ли оперативной памяти: «нормальное» — хватает; «повышенное» — macOS сжимает данные и пользуется свопом; «высокое» — памяти не хватает, программы могут подтормаживать. Немного свопа — обычное дело. Значения сняты один раз, в момент проверки.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory pressure shows whether there is enough RAM: normal means there is; elevated means macOS is compressing data and using swap; high means memory is short and apps may slow down. A little swap is routine. The values were read once, at the moment of the check."
          }
        }
      }
    },
    "Давно не открывались": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not opened in a while"
          }
        }
      }
    },
    "Данные «%@» сброшены": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" data reset"
          }
        }
