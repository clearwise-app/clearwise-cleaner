    "Следов удалённых приложений не найдено": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No traces of removed apps found"
          }
        }
      }
    },
    "Следы приложений, которых уже нет. Сразу отмечены только точные совпадения": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traces of apps that are gone. Only exact matches are checked up front"
          }
        }
      }
    },
    "Следы удалённых приложений": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traces of deleted apps"
          }
        }
      }
    },
    "Службы Apple только показываются: изменить или удалить их здесь нельзя.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's services are shown only: they cannot be changed or removed here."
          }
        }
      }
    },
    "Сначала большие": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest first"
          }
        }
      }
    },
    "Сначала маленькие": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smallest first"
          }
        }
      }
    },
    "Снимки Time Machine на диске": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine snapshots on disk"
          }
        }
      }
    },
    "Снимок": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot"
          }
        }
      }
    },
    "Снять всё": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect all"
          }
        }
      }
    },
    "Снять отметки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect all"
          }
        }
      }
    },
    "Снять отметку": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncheck"
          }
        }
      }
