          }
        }
      }
    },
    "Пора менять": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to replace"
          }
        }
      }
    },
    "Порядок категорий и файлов по размеру": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order of categories and files by size"
          }
        }
      }
